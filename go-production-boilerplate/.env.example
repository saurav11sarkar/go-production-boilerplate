APP_ENV=development
APP_NAME=Go Production API
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# PostgreSQL (docker-compose default)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_production?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

# Auth
JWT_ISSUER=go-production-api
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_TOKEN_IN_BODY=false
REQUIRE_EMAIL_VERIFICATION=true

# HTTP / security
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=10s
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# Storage: local | cloudinary
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail: log | smtp
# log prints verification/reset links to your terminal for easy local testing.
MAIL_PROVIDER=log
MAIL_FROM_NAME=Go Production API
MAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s

# Seed admin
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
