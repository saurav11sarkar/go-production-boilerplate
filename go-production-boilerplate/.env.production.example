# Copy this file to .env only as a starting point. Replace every placeholder.
APP_ENV=production
APP_NAME=My Go API
HTTP_PORT=8080
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://example.com

# Managed PostgreSQL / production database. Require TLS when your provider supports it.
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

JWT_ISSUER=my-go-api
JWT_ACCESS_SECRET=REPLACE_WITH_A_CRYPTOGRAPHIC_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_TOKEN_IN_BODY=false
REQUIRE_EMAIL_VERIFICATION=true

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=10s
# Set true only when the API is behind a trusted reverse proxy/load balancer that overwrites forwarding headers.
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# cloudinary is the recommended example provider for stateless production instances.
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Production refuses MAIL_PROVIDER=log because verification/reset tokens must not be written to logs.
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=My Go API
MAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_TIMEOUT=10s

# Seed is optional in production. If you run it, use a strong secret and remove/rotate it afterward.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
